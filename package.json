{
  "name": "printer-fleet-controller",
  "version": "0.59.9",
  "private": true,
  "type": "module",
  "description": "Print Farm Controller: local-first FlashForge, Snapmaker, Prusa and experimental Bambu fleet control with printer emulation",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "emulator": "node emulator/server.js",
    "test": "node --test",
    "test:audit": "node scripts/audit-regression-tests.mjs",
    "test:browser": "node scripts/browser-regression.mjs",
    "postinstall": "npm run build:frontend",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build:bundle": "npm run build:frontend && node scripts/build-controller-bundle.mjs",
    "build:sea:windows": "node scripts/build-sea-windows.mjs",
    "build:installer:windows": "npm run build:sea:windows && node scripts/build-installer-windows.mjs",
    "sign:windows": "node scripts/sign-windows.mjs",
    "release:windows": "node scripts/build-windows-release.mjs"
  },
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=12.2.0 <13"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "playwright": "1.56.1",
    "preact": "11.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "packageManager": "npm@12.2.0"
}
